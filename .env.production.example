# Copy to an ignored production env file or, preferably, inject equivalent
# values from the deployment secret manager. Never commit populated values.
MEMORYLOOM_POSTGRES_DB=memoryloom
MEMORYLOOM_POSTGRES_USER=memoryloom
MEMORYLOOM_POSTGRES_PASSWORD=
MEMORYLOOM_DATABASE_URL=

MEMORYLOOM_MINIO_ROOT_USER=
MEMORYLOOM_MINIO_ROOT_PASSWORD=

MEMORYLOOM_AUTH_JWT_ISSUER=https://identity.example
MEMORYLOOM_AUTH_JWT_AUDIENCE=memoryloom-api
MEMORYLOOM_AUTH_JWT_JWKS_URL=https://identity.example/.well-known/jwks.json
MEMORYLOOM_AUTH_JWT_ALGORITHMS=RS256
MEMORYLOOM_AUTH_REQUIRED_SCOPE=memory
MEMORYLOOM_AUTH_AUDIT_HMAC_KEY=
MEMORYLOOM_GOVERNANCE_HMAC_KEY=
MEMORYLOOM_GOVERNANCE_PSEUDONYM_KEY_ID=governance-2026-01
MEMORYLOOM_PRIVACY_POLICY_VERSION=privacy-2026-01

MEMORYLOOM_PUBLIC_API_URL=https://memory-api.example
MEMORYLOOM_FRONTEND_URL=https://memory.example
MEMORYLOOM_CORS_ORIGINS=https://memory.example

# Backend runtime. The application reads environment variables directly;
# copy or export these values before starting the process.
MEMORYLOOM_ENVIRONMENT=development
MEMORYLOOM_HOST=127.0.0.1
MEMORYLOOM_PORT=38089
MEMORYLOOM_LOG_LEVEL=INFO
# Use memory for a zero-dependency local run. PostgreSQL requires changing this
# to postgres, setting MEMORYLOOM_DATABASE_URL, and running memoryloom-migrate.
MEMORYLOOM_STORE=memory
MEMORYLOOM_DATABASE_URL=
MEMORYLOOM_DATABASE_POOL_MIN_SIZE=1
MEMORYLOOM_DATABASE_POOL_MAX_SIZE=10
# Maximum pool wait used only by /readyz; ordinary operations keep pool defaults.
MEMORYLOOM_DATABASE_READINESS_TIMEOUT_SECONDS=1.0

# Optional disposable semantic projection. It requires PostgreSQL authority and a
# separately running projector process. Default Compose enables these values.
MEMORYLOOM_PROJECTION_MODE=disabled
MEMORYLOOM_PROJECTION_REQUIRED=false
MEMORYLOOM_PROJECTION_NAME=milvus-memory-v1
MEMORYLOOM_PROJECTION_SEARCH_OVERSAMPLE=10
MEMORYLOOM_MILVUS_URI=http://127.0.0.1:19530
MEMORYLOOM_MILVUS_TOKEN=
MEMORYLOOM_MILVUS_COLLECTION=memoryloom_v1
MEMORYLOOM_MILVUS_CONSISTENCY_LEVEL=Bounded
MEMORYLOOM_MILVUS_TIMEOUT_SECONDS=5.0
MEMORYLOOM_MILVUS_MIN_SIMILARITY=0.15

# `hash` is deterministic and offline. `openai_compatible` calls
# {MEMORYLOOM_EMBEDDING_BASE_URL}/embeddings and should use a production-quality model.
MEMORYLOOM_EMBEDDING_PROVIDER=hash
MEMORYLOOM_EMBEDDING_MODEL=hash-blake2b-v1
MEMORYLOOM_EMBEDDING_DIMENSIONS=384
MEMORYLOOM_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
MEMORYLOOM_EMBEDDING_API_KEY=
MEMORYLOOM_EMBEDDING_TIMEOUT_SECONDS=15.0

# Asynchronous outbox projector lease, retry, and dead-letter controls.
MEMORYLOOM_PROJECTION_WORKER_BATCH_SIZE=64
MEMORYLOOM_PROJECTION_WORKER_LEASE_SECONDS=60.0
MEMORYLOOM_PROJECTION_WORKER_POLL_SECONDS=1.0
MEMORYLOOM_PROJECTION_WORKER_RETRY_BASE_SECONDS=2.0
MEMORYLOOM_PROJECTION_WORKER_RETRY_MAX_SECONDS=300.0
MEMORYLOOM_PROJECTION_WORKER_MAX_ATTEMPTS=8
MEMORYLOOM_MAX_REQUEST_BODY_BYTES=1048576
# Local evaluation only. Staging/production must use jwt and configure all
# issuer/audience/JWKS/audit values below.
MEMORYLOOM_AUTH_MODE=development
MEMORYLOOM_AUTH_JWT_ISSUER=
MEMORYLOOM_AUTH_JWT_AUDIENCE=
MEMORYLOOM_AUTH_JWT_JWKS_URL=
MEMORYLOOM_AUTH_JWT_ALGORITHMS=RS256
MEMORYLOOM_AUTH_REQUIRED_SCOPE=memory
MEMORYLOOM_AUTH_AUDIT_HMAC_KEY=
MEMORYLOOM_AUTH_AUDIT_SINK=log
# Production/staging require postgres governance and a separate HMAC secret.
MEMORYLOOM_GOVERNANCE_MODE=development
MEMORYLOOM_GOVERNANCE_HMAC_KEY=
MEMORYLOOM_GOVERNANCE_PSEUDONYM_KEY_ID=governance-v1
MEMORYLOOM_PRIVACY_POLICY_VERSION=privacy-v1
MEMORYLOOM_FRONTEND_URL=http://127.0.0.1:33009
# Shared by backend service discovery and the standalone frontend's browser runtime config/CSP.
MEMORYLOOM_PUBLIC_API_URL=http://127.0.0.1:38089
MEMORYLOOM_CORS_ORIGINS=http://127.0.0.1:33009,http://localhost:33009

# Standalone static frontend.
MEMORYLOOM_FRONTEND_HOST=127.0.0.1
MEMORYLOOM_FRONTEND_PORT=33009

# Destructive PostgreSQL test fixtures are intentionally not enabled here.
# For a disposable database whose name ends in `_test`, export both variables
# only in the test shell:
# MEMORYLOOM_TEST_DATABASE_URL=postgresql://memoryloom:password@127.0.0.1:5432/memoryloom_test
# MEMORYLOOM_ALLOW_DESTRUCTIVE_TEST_DATABASE=1
